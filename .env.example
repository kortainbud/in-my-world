# ── Mode ────────────────────────────────────────────────────────────────
# development (default): allows the dev providers below, clearly labelled in the UI.
# production: only real providers; missing ones fail with a clear error.
IMW_MODE=development

# Where the local JSON store and media live (development store only).
DATA_DIR=.data

# ── Story provider ──────────────────────────────────────────────────────
# Set an Anthropic key to write stories with Claude. Without it, development
# mode uses the template story engine (not AI) and production refuses to generate.
ANTHROPIC_API_KEY=
# Optional overrides
# STORY_PROVIDER=anthropic        # or dev-template (development only)
# STORY_MODEL=claude-opus-5-5

# ── Voice provider ──────────────────────────────────────────────────────
# macos-say: local macOS system voices (development only, macOS hosts only).
# none: no narration — videos get captions, music and sound effects.
# VOICE_PROVIDER=macos-say

# ── Card payments (Stripe) ─────────────────────────────────────────────
# Plans (monthly) and credit packs. Use test keys (sk_test_…) until launch.
# Webhook endpoint: https://<your-domain>/api/billing/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         invoice.paid, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Crypto payments (Solana: USDC + SOL) ───────────────────────────────
# Credit packs paid straight to your wallet. Public address only — never a seed phrase.
SOLANA_RECEIVER_ADDRESS=
# mainnet-beta (default) or devnet for testing
SOLANA_CLUSTER=mainnet-beta
# A private RPC (e.g. Helius free tier) is recommended; the public one is rate-limited.
SOLANA_RPC_URL=
# Optional override (defaults to Circle's USDC mint for the cluster)
# SOLANA_USDC_MINT=

# ── Supabase (production data layer — see README "Moving to Supabase") ─
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
