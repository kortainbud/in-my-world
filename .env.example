# ── Mode ────────────────────────────────────────────────────────────────
# development (default): allows the dev providers below, clearly labelled in the UI.
# production: only real providers; missing ones fail with a clear error.
IMW_MODE=development

# Where the local JSON store and media live (development store only).
DATA_DIR=.data

# ── Story provider ──────────────────────────────────────────────────────
# Set an Anthropic key to write stories with Claude. Without it, development
# mode uses the template story engine (not AI) and production refuses to generate.
ANTHROPIC_API_KEY=
# Optional overrides
# STORY_PROVIDER=anthropic        # or dev-template (development only)
# STORY_MODEL=claude-opus-5-5

# ── Voice provider ──────────────────────────────────────────────────────
# macos-say: local macOS system voices (development only, macOS hosts only).
# none: no narration — videos get captions, music and sound effects.
# VOICE_PROVIDER=macos-say

# ── Payments ────────────────────────────────────────────────────────────
# Comma-separated provider ids registered in src/lib/server/payments.ts.
# none: plans and credit packs are shown but can't be purchased.
PAYMENTS_PROVIDER=none

# ── Supabase (production data layer — see README "Moving to Supabase") ─
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
